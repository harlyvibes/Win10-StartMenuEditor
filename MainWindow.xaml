<Window x:Class="StartMenuEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start Menu Editor" Height="560" Width="900"
        Icon="Assets/app.ico"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Bar}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <DockPanel Margin="6,4">
                <Button x:Name="ThemeButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                        Margin="0" ToolTip="Switch between dark and light mode" Click="Theme_Click" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Refresh" Style="{StaticResource ToolButton}" Click="Refresh_Click" />
                    <Rectangle Width="1" Margin="6,4" Fill="{DynamicResource Brush.Border}" />
                    <Button Content="New folder" Style="{StaticResource ToolButton}" Click="NewFolder_Click" />
                    <Button Content="Rename" Style="{StaticResource ToolButton}" Click="Rename_Click" />
                    <Button Content="Delete" Style="{StaticResource ToolButton}" Click="Delete_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid DockPanel.Dock="Top" Margin="6,6,6,2">
            <TextBox x:Name="SearchBox" Padding="6,4,26,4" VerticalContentAlignment="Center"
                     ToolTip="Search shortcuts and folders (Ctrl+F). Esc clears."
                     TextChanged="SearchBox_TextChanged"
                     PreviewKeyDown="SearchBox_PreviewKeyDown" />
            <TextBlock Text="Search shortcuts and folders..." Foreground="{DynamicResource Brush.TextDim}"
                       Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Content="&#x2715;" Width="22" Height="22" Margin="0,0,3,0" HorizontalAlignment="Right"
                    VerticalAlignment="Center" ToolTip="Clear search" Click="ClearSearch_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="1.2*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="Tree" Grid.Column="0" Margin="6,4,0,6" AllowDrop="True"
                      SelectedItemChanged="Tree_SelectedItemChanged"
                      PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                      PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                      ContextMenuOpening="Tree_ContextMenuOpening"
                      KeyDown="Tree_KeyDown"
                      MouseMove="Tree_MouseMove"
                      DragOver="Tree_DragOver"
                      Drop="Tree_Drop">
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="MenuNewFolder" Header="New folder" Click="NewFolder_Click" />
                        <MenuItem x:Name="MenuRename" Header="Rename" InputGestureText="F2" Click="Rename_Click" />
                        <Separator Style="{StaticResource MenuSeparator}" />
                        <MenuItem x:Name="MenuDelete" Header="Delete" InputGestureText="Del" Click="Delete_Click" />
                    </ContextMenu>
                </TreeView.ContextMenu>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Name}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />

            <StackPanel x:Name="Details" Grid.Column="2" Margin="8,8,10,8" IsEnabled="False">
                <TextBlock Text="Location" FontWeight="SemiBold" />
                <TextBlock x:Name="PathText" TextWrapping="Wrap" Margin="0,2,0,12"
                           Foreground="{DynamicResource Brush.TextDim}" />

                <TextBlock Text="Target" />
                <TextBox x:Name="TargetBox" Margin="0,2,0,8" />

                <TextBlock Text="Arguments" />
                <TextBox x:Name="ArgumentsBox" Margin="0,2,0,8" />

                <TextBlock Text="Start in" />
                <TextBox x:Name="WorkingDirBox" Margin="0,2,0,8" />

                <TextBlock Text="Comment" />
                <TextBox x:Name="DescriptionBox" Margin="0,2,0,12" />

                <Button Content="Save changes" HorizontalAlignment="Left" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
