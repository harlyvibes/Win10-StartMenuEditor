<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Same keys as LightTheme.xaml; ThemeService swaps one for the other at runtime. -->
    <SolidColorBrush x:Key="Brush.Window" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#252526" />
    <SolidColorBrush x:Key="Brush.Bar" Color="#2D2D30" />
    <SolidColorBrush x:Key="Brush.Menu" Color="#2B2B2E" />
    <SolidColorBrush x:Key="Brush.Control" Color="#3A3A3F" />
    <SolidColorBrush x:Key="Brush.Border" Color="#454549" />
    <SolidColorBrush x:Key="Brush.Text" Color="#E8E8E8" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="#A0A0A5" />
    <SolidColorBrush x:Key="Brush.Disabled" Color="#6E6E73" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#3F4045" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#4C4D53" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#0E639C" />
    <SolidColorBrush x:Key="Brush.SelectedInactive" Color="#3A3D41" />
    <SolidColorBrush x:Key="Brush.SelectedText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#3D93F7" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#5A5A60" />
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#7A7A82" />

    <!-- WPF paints the square where two scroll bars meet with this system brush. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#252526" />

</ResourceDictionary>
