<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Same keys as DarkTheme.xaml; ThemeService swaps one for the other at runtime. -->
    <SolidColorBrush x:Key="Brush.Window" Color="#F3F3F3" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Bar" Color="#E9E9EC" />
    <SolidColorBrush x:Key="Brush.Menu" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Control" Color="#F7F7F8" />
    <SolidColorBrush x:Key="Brush.Border" Color="#C9C9CE" />
    <SolidColorBrush x:Key="Brush.Text" Color="#1B1B1D" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="#6B6B72" />
    <SolidColorBrush x:Key="Brush.Disabled" Color="#A5A5AB" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#DADCE2" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#C8CBD3" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#CCE1FA" />
    <SolidColorBrush x:Key="Brush.SelectedInactive" Color="#E1E1E5" />
    <SolidColorBrush x:Key="Brush.SelectedText" Color="#1B1B1D" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#1A6FE0" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#B8B8BE" />
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#8F8F96" />

    <!-- WPF paints the square where two scroll bars meet with this system brush. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF" />

</ResourceDictionary>
